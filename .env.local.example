ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Subscription Price IDs (price_...), NOT Product IDs (prod_...).
# Stripe Dashboard → Product → click your product → under "Pricing" copy each Price's API ID.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ULTRA=price_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel): https://avtopartfinder.com — also set in vercel.json and auto-used when VERCEL_ENV=production.
# Comma-separated admin emails (server-only). Must match the user's login email.
ADMIN_EMAILS=you@example.com

# Resend (welcome + usage limit emails)
RESEND_API_KEY=
RESEND_FROM=PartFinder AI <noreply@avtopartfinder.com>

# Sentry (optional) — set NEXT_PUBLIC_SENTRY_DSN for client + SENTRY_DSN for server
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Google Stitch (optional) — download design HTML: node scripts/fetch-stitch-blog.mjs
STITCH_API_KEY=

# --- Production (Vercel + Supabase + Stripe) quick checklist ---
# 1) Vercel: import repo, add every variable above in Project → Settings → Environment Variables (Production).
# 2) NEXT_PUBLIC_APP_URL: Production = https://avtopartfinder.com (included in vercel.json; optional duplicate in Vercel dashboard).
# 3) Supabase Dashboard → Authentication → URL Configuration:
#    Site URL = https://avtopartfinder.com (NOT localhost — otherwise confirm emails point to localhost)
#    Redirect URLs: https://avtopartfinder.com/auth/callback , https://avtopartfinder.com/** , http://localhost:3000/auth/callback , http://localhost:3000/**
# 4) Supabase: run SQL migrations (supabase/migrations) on the linked project; confirm Storage bucket "part-images" exists.
#    After 20260513_part_images_private_signed_urls.sql: bucket is private; images open via /api/me/search-image and /api/admin/search-image (short-lived signed URLs).
# 5) Stripe Dashboard → Developers → Webhooks → Add endpoint: https://<your-domain>/api/stripe/webhook
#    Subscribe to: checkout.session.completed, customer.subscription.updated. Paste signing secret into STRIPE_WEBHOOK_SECRET.
# 6) Stripe: use Live mode keys (sk_live_..., pk_live_...) and live Price IDs (price_...) in Production env on Vercel.
# 7) Stripe: enable Customer Portal (Settings → Billing → Customer portal) for "Manage billing".
# 8) Supabase: run 20260520_search_shares_and_billing.sql (share links + stripe_customer_id + email flags).
# 9) Resend: verify sending domain; set RESEND_API_KEY and RESEND_FROM on Vercel.
